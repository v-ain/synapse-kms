{
  "name": "synapse-kms",
  "version": "1.0.0",
  "description": "High-performance, enterprise-grade distributed knowledge management ecosystem built with a focus on strict low-level resource management, predictable data constraints, and high-concurrency architecture.",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=@synapse-kms/server",
    "dev:client": "npm run dev --workspace=@synapse-kms/client",
    "db:start": "podman compose up -d",
    "db:stop": "podman compose down",
    "db:generate": "npm run --prefix packages/db-scripts db:generate",
    "db:migrate": "npm run --prefix packages/db-scripts db:migrate",
    "db:studio": "npm run --prefix packages/db-scripts db:studio"
  },
  "author": "v-ain",
  "license": "ISC",
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
